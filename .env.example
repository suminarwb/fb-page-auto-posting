# Salin file ini ke .env dan isi dengan value asli. JANGAN commit .env ke git.
# Isi HANYA secret provider yang benar-benar dipakai (lihat llm.generatorProvider /
# llm.verifierProvider di config.json) — tidak perlu isi ketiganya sekaligus.

# Anthropic Claude API — https://platform.claude.com/
ANTHROPIC_API_KEY=

# OpenAI API — https://platform.openai.com/ (dipakai kalau llm.*Provider = "openai")
OPENAI_API_KEY=

# Google Gemini API — https://aistudio.google.com/apikey (dipakai kalau llm.*Provider = "gemini")
GEMINI_API_KEY=

# Facebook Page Access Token (System User, long-lived) — lihat docs/04-API-INTEGRATION.md §2.1
FB_PAGE_ACCESS_TOKEN=

# Facebook Page ID Stik Satu. Bukan secret secara teknis, tapi disimpan di .env (bukan
# config.json) supaya repo open-source tidak menunjuk ke Page asli lewat riwayat git.
FB_PAGE_ID=

# Facebook App ID (dibutuhkan untuk resumable upload video ke /uploads — lihat
# docs/04-API-INTEGRATION.md §2). Sama seperti FB_PAGE_ID, bukan secret secara teknis
# tapi disimpan di sini biar tidak identifiable di config.json yang di-commit.
FB_APP_ID=

# Cloudflare Workers AI — dipakai generate gambar otomatis kalau assets/branding/ kosong
# (imageGeneration.enabled di config.json). Gratis sampai 10.000 neuron/hari — dashboard.cloudflare.com
CLOUDFLARE_ACCOUNT_ID=
# Buat API Token di dashboard.cloudflare.com/profile/api-tokens — pakai template
# "Create a Workers AI API Token" (otomatis isi permission "Workers AI - Read" + "Workers AI - Edit")
CLOUDFLARE_API_TOKEN=
